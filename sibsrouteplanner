      </div>
      ${renderAllocGroup(route.id, alloc.regular||[], 'regular', 'Regular')}
      ${(route.fleet.some(f=>f.type==='peak')) ? renderAllocGroup(route.id, alloc.peak||[], 'peak', 'Peak-Hour (S)') : ''}
      ${(route.fleet.some(f=>f.type==='additional'||f.type==='additional_42A')) ? renderAllocGroup(route.id, alloc.additional||[], 'additional', 'Additional (A)') : ''}
    </div>`;
  }).join('');
}

function renderAllocGroup(routeId, buses, type, label) {
  if(buses.length===0) return '';
  return `
  <div style="margin-top:8px">
    <div class="text-muted" style="font-size:11px;font-weight:700;text-transform:uppercase;margin-bottom:6px">${label} Allocation</div>
    <div style="display:flex;flex-wrap:wrap;gap:6px">
      ${buses.map((num,i)=>`
        <div style="display:flex;align-items:center;gap:4px;background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:4px 8px">
          <span style="font-size:11px;color:var(--text-muted)">Bus ${i+1}</span>
          <select class="inline-edit-input" style="width:160px" onchange="changeBusAllocation('${routeId}','${type}',${i},this.value)">
            ${getEligibleBuses(num).map(n=>`<option value="${n}" ${n===num?'selected':''}>#${n} ${FLEET_MASTER[n]||''}</option>`).join('')}
          </select>
        </div>`).join('')}
    </div>
  </div>`;
}

function getEligibleBuses(fleetNum) {
  const series = getFleetSeries(fleetNum);
  if(!series) return [fleetNum];
  return Object.keys(FLEET_MASTER).filter(n => getFleetSeries(n)===series).map(Number).sort((a,b)=>a-b);
}

function changeBusAllocation(routeId, type, idx, newVal) {
  const alloc = state.currentAllocation[routeId] || {};
  const group = [...(alloc[type]||[])];
  const newNum = parseInt(newVal);

  // Check not already used
  let conflict = null;
  ROUTES.forEach(r => {
    if(r.id===routeId) return;
    const a = state.currentAllocation[r.id] || {};
    ['regular','peak','additional'].forEach(t => {
      if((a[t]||[]).includes(newNum)) conflict = r.id;
    });
  });

  if(conflict) {
    alert(`Bus #${newNum} is already allocated to Route ${conflict}. Please swap it first.`);
    return;
  }

  group[idx] = newNum;
  state.currentAllocation[routeId] = { ...alloc, [type]: group };
}

function reshuffleRoute(routeId) {
  const route = ROUTES.find(r=>r.id===routeId);
  if(!route) return;
  const byType = { regular:[], peak:[], additional:[] };
  route.fleet.forEach(f => {
    const t = f.type === 'additional_42A' ? 'additional' : f.type;
    byType[t].push(f.num);
  });
  state.currentAllocation[routeId] = {
    regular: shuffleArray(byType.regular),
    peak: shuffleArray(byType.peak),
    additional: shuffleArray(byType.additional),
  };
  renderAllocationTable();
}

function reshuffleAll() {
  if(!confirm('Reshuffle all bus allocations for a new day? This simulates the daily reshuffle.')) return;
  ROUTES.forEach(route => {
    const byType = { regular:[], peak:[], additional:[] };
    route.fleet.forEach(f => {
      const t = f.type === 'additional_42A' ? 'additional' : f.type;
      byType[t].push(f.num);
    });
    state.currentAllocation[route.id] = {
      regular: shuffleArray(byType.regular),
      peak: shuffleArray(byType.peak),
      additional: shuffleArray(byType.additional),
    };
  });
  renderAllocationTable();
  alert('✅ All allocations reshuffled for the new day!');
}

function resetToDefault() {
  if(!confirm('Reset all allocations to their default (as-listed) order?')) return;
  initAllocation();
  renderAllocationTable();
}

// ============================================================
// DIVERSIONS
// ============================================================
function addDiversion() {
  const route = document.getElementById('divRoute').value;
  const type = document.getElementById('divType').value;
  const message = document.getElementById('divMessage').value.trim();
  const stops = document.getElementById('divStops').value.trim();

  if(!route || !message) { alert('Please select a route and enter a notice message.'); return; }

  state.diversions.push({ route, type, message, stops, id: Date.now() });
  renderDiversionList();
  document.getElementById('divMessage').value = '';
  document.getElementById('divStops').value = '';
}

function removeDiversion(id) {
  state.diversions = state.diversions.filter(d=>d.id!==id);
  renderDiversionList();
}

function renderDiversionList() {
  const wrap = document.getElementById('diversionList');
  if(state.diversions.length===0) {
    wrap.innerHTML = `<div class="empty-state"><div class="big">✅</div><p>No active diversion notices</p></div>`;
    return;
  }
  wrap.innerHTML = state.diversions.map(d=>`
    <div class="diversion-banner" style="margin-bottom:8px">
      <div class="diversion-icon">${d.type==='cancellation'?'🚫':d.type==='delay'?'⏱️':d.type==='extra'?'➕':'⚠️'}</div>
      <div class="diversion-text" style="flex:1">
        <strong>Route ${d.route} – ${d.type.charAt(0).toUpperCase()+d.type.slice(1)}</strong>
        ${d.message}
        ${d.stops ? `<div class="mt-4 text-muted">Affected stops: ${d.stops}</div>` : ''}
      </div>
      <button class="btn btn-danger btn-sm" onclick="removeDiversion(${d.id})">Remove</button>
    </div>`).join('');
}

// ============================================================
// THIRD PARTY OPERATORS
// ============================================================
function renderOpTable(op) {
  const wrap = document.getElementById(op+'Table');
  const data = state.thirdParty[op] || [];

  const addRow = () => {
    state.thirdParty[op] = state.thirdParty[op] || [];
    state.thirdParty[op].push({ fleet:'', reg:'', route:'', service:'', notes:'' });
    renderOpTable(op);
  };

  wrap.innerHTML = `
    <div style="margin-bottom:12px;display:flex;justify-content:space-between;align-items:center">
      <span class="text-muted">${data.length} bus${data.length!==1?'es':''} entered</span>
      <button class="btn btn-primary btn-sm" onclick="(${addRow.toString()})()">+ Add Bus</button>
    </div>
    <table class="admin-table">
      <thead><tr>
        <th>Fleet #</th><th>Registration</th><th>Route</th><th>Service Hours</th><th>Notes</th><th></th>
      </tr></thead>
      <tbody>
        ${data.length===0 ? `<tr><td colspan="6" class="text-center text-muted" style="padding:20px">No ${op.toUpperCase()} buses entered yet. Click "+ Add Bus" to begin.</td></tr>` :
          data.map((row,i)=>`
          <tr>
            <td><input class="inline-edit-input" value="${row.fleet}" placeholder="e.g. 4001" oninput="updateOpRow('${op}',${i},'fleet',this.value)" style="width:80px"/></td>
            <td><input class="inline-edit-input" value="${row.reg}" placeholder="MM0001" oninput="updateOpRow('${op}',${i},'reg',this.value)" style="width:100px"/></td>
            <td><input class="inline-edit-input" value="${row.route}" placeholder="e.g. 473" oninput="updateOpRow('${op}',${i},'route',this.value)" style="width:70px"/></td>
            <td><input class="inline-edit-input" value="${row.service}" placeholder="e.g. 06:00–23:00" oninput="updateOpRow('${op}',${i},'service',this.value)" style="width:140px"/></td>
            <td><input class="inline-edit-input" value="${row.notes}" placeholder="Notes…" oninput="updateOpRow('${op}',${i},'notes',this.value)" style="width:160px"/></td>
            <td><button class="btn btn-danger btn-sm" onclick="removeOpRow('${op}',${i})">✕</button></td>
          </tr>`).join('')}
      </tbody>
    </table>`;
}

function updateOpRow(op, i, field, val) {
  if(!state.thirdParty[op]) state.thirdParty[op]=[];
  if(!state.thirdParty[op][i]) state.thirdParty[op][i]={};
  state.thirdParty[op][i][field] = val;
}

function removeOpRow(op, i) {
  state.thirdParty[op].splice(i,1);
  renderOpTable(op);
}

