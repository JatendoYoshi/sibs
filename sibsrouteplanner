// ============================================================
// CLOCK
// ============================================================
function updateClock() {
  const now = new Date();
  const h = String(now.getHours()).padStart(2,'0');
  const m = String(now.getMinutes()).padStart(2,'0');
  const s = String(now.getSeconds()).padStart(2,'0');
  document.getElementById('navClock').textContent = `${h}:${m}:${s}`;
}
setInterval(updateClock,1000); updateClock();

// ============================================================
// PEAK HOURS CHECK
// ============================================================
function isPeakHour(date) {
  date = date || new Date();
  const h = date.getHours(), m = date.getMinutes();
  const mins = h*60+m;
  return (mins >= 7*60+20 && mins < 9*60) || (mins >= 15*60+30 && mins < 19*60+20);
}

// ============================================================
// DAILY SHUFFLE
// ============================================================
function shuffleArray(arr) {
  const a = [...arr];
  for(let i=a.length-1;i>0;i--) {
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]] = [a[j],a[i]];
  }
  return a;
}

function initAllocation() {
  // Seed by day so allocation is stable per day
  const dayStr = new Date().toDateString();
  const seed = dayStr.split('').reduce((a,c)=>a+c.charCodeAt(0),0);
  let rngState = seed;
  function rng() { rngState = (rngState * 1664525 + 1013904223) & 0xFFFFFFFF; return (rngState >>> 0) / 0xFFFFFFFF; }
  function seededShuffle(arr) {
    const a = [...arr];
    for(let i=a.length-1;i>0;i--) { const j=Math.floor(rng()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
    return a;
  }

  // Build pools by fleet series, shuffle within series
  const fleetByRoute = {};
  ROUTES.forEach(route => {
    const byType = { regular:[], peak:[], additional:[] };
    route.fleet.forEach(f => {
      const type = f.type === 'additional' || f.type === 'additional_42A' ? 'additional' : f.type;
      byType[type].push(f.num);
    });
    // Shuffle each type group within their fleet series
    const shuffleGroup = (nums) => {
      if(nums.length < 2) return nums;
      const series = getFleetSeries(nums[0]);
      // Get all buses in same series that are in this group
      return seededShuffle(nums);
    };
    fleetByRoute[route.id] = {
      regular: shuffleGroup(byType.regular),
      peak: shuffleGroup(byType.peak),
      additional: shuffleGroup(byType.additional),
    };
  });
  state.currentAllocation = fleetByRoute;
}

// ============================================================
// PAGES
// ============================================================
function showPage(id, btn) {
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('page-'+id).classList.add('active');
  if(btn) btn.classList.add('active');

  // Lazy init page content
  if(id==='routes') renderRoutes();
  if(id==='arrivals') initArrivals();
  if(id==='planner') initPlanner();
  if(id==='fleet') renderFleet('all');
  if(id==='admin') renderAdmin();
  if(id==='home') renderHome();
}

// ============================================================
// HOME
// ============================================================
function renderHome() {
  // Stat: buses on duty
  let totalBuses = 0;
  const peak = isPeakHour();
  ROUTES.forEach(r => {
    const alloc = state.currentAllocation[r.id] || {};
    totalBuses += (alloc.regular||[]).length + (peak ? (alloc.peak||[]).length : 0);
  });
  document.getElementById('statBuses').textContent = totalBuses;

  const divCount = state.diversions.length;
  document.getElementById('statDiversions').textContent = divCount;
  document.getElementById('statOnTime').textContent = divCount === 0 ? '100%' : Math.round((1 - divCount/ROUTES.length)*100) + '%';

  // Status banners
  const sb = document.getElementById('statusBanners');
  if(state.diversions.length === 0) {
    sb.innerHTML = `<div class="status-banner" style="margin-bottom:16px">
      <div class="status-dot green"></div>
      <div class="status-text"><strong>All Services Operating Normally</strong> — No disruptions reported across the SIBS network</div>
    </div>`;
  } else {
    sb.innerHTML = state.diversions.map(d=>`
      <div class="status-banner" style="margin-bottom:8px">
        <div class="status-dot ${d.type==='cancellation'?'red':'orange'}"></div>
        <div class="status-text"><strong>Route ${d.route}</strong> — ${d.message}</div>
      </div>`).join('');
  }

  // Home arrivals (first 5)
  const now = new Date();
  const homeArrivals = document.getElementById('homeArrivals');
  const upcomingAll = [];
  ROUTES.slice(0,6).forEach(route => {
    const mins = getNextBusMins(route, now);
