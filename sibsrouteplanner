<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>SIBS – Sunshine Islands Bus Simulator</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+HK:wght@400;500;700;900&family=Inter:wght@400;500;600;700&display=swap');

  :root {
    --yellow: #F5C200;
    --yellow-dark: #D4A800;
    --yellow-light: #FFF8D6;
    --blue: #3ABDE8;
    --blue-dark: #1A8CB5;
    --blue-light: #E8F8FD;
    --white: #FFFFFF;
    --bg: #F4F6F9;
    --text: #1A1A2E;
    --text-muted: #6B7280;
    --border: #E5E7EB;
    --card: #FFFFFF;
    --red: #EF4444;
    --green: #22C55E;
    --orange: #F97316;
    --shadow: 0 2px 8px rgba(0,0,0,0.08);
    --shadow-lg: 0 8px 24px rgba(0,0,0,0.12);
    --radius: 12px;
    --radius-sm: 8px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', 'Noto Sans HK', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    font-size: 14px;
  }

  /* ===== TOP NAV ===== */
  #topnav {
    background: var(--text);
    padding: 0 20px;
    display: flex;
    align-items: center;
    height: 56px;
    gap: 0;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 12px rgba(0,0,0,0.3);
  }
  .logo-block {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: 32px;
    text-decoration: none;
  }
  .logo-badge {
    background: var(--yellow);
    color: var(--text);
    font-weight: 900;
    font-size: 14px;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.5px;
  }
  .logo-text {
    color: var(--white);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
  }
  .nav-links {
    display: flex;
    gap: 2px;
    flex: 1;
    overflow-x: auto;
  }
  .nav-btn {
    background: none;
    border: none;
    color: rgba(255,255,255,0.7);
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    transition: all 0.15s;
    font-family: inherit;
  }
  .nav-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }
  .nav-btn.active { background: var(--yellow); color: var(--text); font-weight: 700; }
  .nav-clock {
    color: var(--yellow);
    font-size: 13px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    margin-left: auto;
    padding-left: 16px;
  }

  /* ===== MAIN ===== */
  #main { padding: 24px 20px; max-width: 1200px; margin: 0 auto; }

  /* ===== PAGE HEADER ===== */
  .page-header {
    margin-bottom: 24px;
  }
  .page-title {
    font-size: 22px;
    font-weight: 800;
    color: var(--text);
  }
  .page-title span { color: var(--blue-dark); }
  .page-sub {
    color: var(--text-muted);
    font-size: 13px;
    margin-top: 4px;
  }

  /* ===== CARDS ===== */
  .card {
    background: var(--card);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 20px;
    border: 1px solid var(--border);
  }
  .card-title {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .card-title .icon {
    width: 28px; height: 28px;
    background: var(--yellow-light);
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px;
  }

  /* ===== GRID ===== */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  @media(max-width:900px) { .grid-4 { grid-template-columns: 1fr 1fr; } }
  @media(max-width:600px) { .grid-2,.grid-3 { grid-template-columns: 1fr; } }

  /* ===== STATUS BANNER ===== */
  .status-banner {
    background: linear-gradient(135deg, var(--text) 0%, #2d3561 100%);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    overflow: hidden;
    position: relative;
  }
  .status-banner::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--yellow);
  }
  .status-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .status-dot.green { background: var(--green); box-shadow: 0 0 8px var(--green); }
  .status-dot.red { background: var(--red); box-shadow: 0 0 8px var(--red); animation: pulse 1.5s infinite; }
  .status-dot.orange { background: var(--orange); box-shadow: 0 0 8px var(--orange); }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
  .status-text { color: #fff; font-size: 13px; }
  .status-text strong { color: var(--yellow); }

  /* ===== ROUTE TAG ===== */
  .route-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--blue);
    color: #fff;
    font-weight: 800;
    font-size: 13px;
    padding: 3px 9px;
    border-radius: 5px;
    min-width: 44px;
    letter-spacing: 0.3px;
  }
  .route-tag.ftcc { background: var(--blue); }
  .route-tag.ft { background: #1A5276; }
  .route-tag.rebc { background: #7B241C; }
  .route-tag.csb { background: #1E8449; }
  .route-tag.hzii { background: #6C3483; }
  .route-tag.sibs { background: #B7950B; }

  /* ===== OPERATOR BADGE ===== */
  .op-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
  }
  .op-badge.ftcc { background: #E8F8FD; color: var(--blue-dark); }
  .op-badge.ft { background: #D6EAF8; color: #1A5276; }
  .op-badge.rebc { background: #FDEDEC; color: #7B241C; }
  .op-badge.csb { background: #EAFAF1; color: #1E8449; }
  .op-badge.hzii { background: #F5EEF8; color: #6C3483; }

  /* ===== ROUTE LIST ===== */
  .route-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: all 0.15s;
    border-radius: 8px;
    padding-left: 8px;
    margin-left: -8px;
  }
  .route-item:hover { background: var(--blue-light); }
  .route-item:last-child { border-bottom: none; }
  .route-meta { flex: 1; }
  .route-name { font-weight: 700; font-size: 14px; margin-bottom: 2px; }
  .route-via { font-size: 12px; color: var(--text-muted); }
  .route-info { display: flex; gap: 8px; align-items: center; margin-top: 6px; flex-wrap: wrap; }
  .pill {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 10px;
    font-weight: 600;
  }
  .pill.fare { background: var(--yellow-light); color: #92640A; }
  .pill.time { background: #F0F9FF; color: var(--blue-dark); }
  .pill.service { background: #F0FDF4; color: #15803D; }

  /* ===== FLEET BADGE ===== */
  .fleet-badge {
    background: var(--text);
    color: var(--yellow);
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.5px;
  }

  /* ===== ARRIVALS BOARD ===== */
  .arrivals-board {
    background: var(--text);
    border-radius: var(--radius);
    overflow: hidden;
    border: 2px solid var(--yellow);
  }
  .arrivals-header {
    background: var(--yellow);
    padding: 10px 16px;
    font-weight: 800;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .arrivals-row {
    display: grid;
    grid-template-columns: 70px 1fr 80px 90px 90px;
    gap: 8px;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    align-items: center;
  }
  .arrivals-row:last-child { border-bottom: none; }
  .arrivals-row:hover { background: rgba(255,255,255,0.04); }
  .arr-route { }
  .arr-dest { color: #fff; font-size: 13px; font-weight: 600; }
  .arr-time {
    color: var(--yellow);
    font-weight: 800;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .arr-fleet { color: rgba(255,255,255,0.6); font-size: 11px; }
  .arr-status { font-size: 11px; font-weight: 600; }
  .arr-status.on-time { color: var(--green); }
  .arr-status.delayed { color: var(--red); }
  .arrivals-cols {
    display: grid;
    grid-template-columns: 70px 1fr 80px 90px 90px;
    gap: 8px;
    padding: 6px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.15);
  }
  .arrivals-col-label { color: rgba(255,255,255,0.5); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }

  /* ===== STOP DETAIL ===== */
  .stop-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }
  .stop-row:last-child { border-bottom: none; }
  .stop-num {
    width: 24px; height: 24px;
    background: var(--blue);
    color: #fff;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .stop-name { flex: 1; font-weight: 500; }
  .stop-time { color: var(--blue-dark); font-weight: 700; font-variant-numeric: tabular-nums; }
  .stop-delay { color: var(--red); font-size: 11px; font-weight: 600; }

  /* ===== JOURNEY PLANNER ===== */
  .planner-form {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 12px;
    align-items: end;
  }
  @media(max-width:700px) { .planner-form { grid-template-columns: 1fr; } }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-label { font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
  .form-input {
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    font-size: 13px;
    font-family: inherit;
    background: #fff;
    outline: none;
    transition: border-color 0.15s;
    width: 100%;
  }
  .form-input:focus { border-color: var(--blue); }
  .form-select {
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    font-size: 13px;
    font-family: inherit;
    background: #fff;
    outline: none;
    cursor: pointer;
    width: 100%;
  }
  .btn {
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    border: none;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .btn-primary { background: var(--yellow); color: var(--text); }
  .btn-primary:hover { background: var(--yellow-dark); }
  .btn-blue { background: var(--blue); color: #fff; }
  .btn-blue:hover { background: var(--blue-dark); }
  .btn-ghost { background: transparent; border: 1.5px solid var(--border); color: var(--text); }
  .btn-ghost:hover { background: var(--bg); }
  .btn-danger { background: var(--red); color: #fff; }
  .btn-sm { padding: 6px 12px; font-size: 12px; }

  /* ===== JOURNEY RESULT ===== */
  .journey-option {
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin-top: 12px;
    transition: all 0.15s;
    cursor: pointer;
  }
  .journey-option:hover { border-color: var(--blue); background: var(--blue-light); }
  .journey-option.best { border-color: var(--yellow); background: var(--yellow-light); }
  .journey-badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 10px;
    margin-bottom: 8px;
    display: inline-block;
  }
  .journey-badge.fastest { background: var(--green); color: #fff; }
  .journey-badge.cheapest { background: var(--yellow); color: var(--text); }
  .journey-badge.direct { background: var(--blue); color: #fff; }
  .journey-steps {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin: 8px 0;
    font-size: 13px;
  }
  .journey-arrow { color: var(--text-muted); }
  .journey-footer {
    display: flex;
    gap: 16px;
    margin-top: 10px;
    font-size: 12px;
    color: var(--text-muted);
  }
  .journey-footer strong { color: var(--text); }

  /* ===== TIMETABLE ===== */
  .timetable-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media(max-width:700px) { .timetable-grid { grid-template-columns: 1fr; } }
  .tt-period {
    padding: 8px 12px;
    background: var(--bg);
    border-radius: 6px;
    font-size: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }
  .tt-interval { color: var(--blue-dark); font-weight: 700; }

  /* ===== DIVERSION ===== */
  .diversion-banner {
    background: #FEF3C7;
    border: 1.5px solid #F59E0B;
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-bottom: 8px;
  }
  .diversion-icon { font-size: 16px; flex-shrink: 0; }
  .diversion-text { font-size: 12px; }
  .diversion-text strong { font-size: 13px; display: block; margin-bottom: 2px; }

  /* ===== ADMIN ===== */
  .admin-section { margin-bottom: 28px; }
  .admin-section-title {
    font-size: 16px;
    font-weight: 800;
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--yellow);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .admin-table th {
    text-align: left;
    padding: 8px 12px;
    background: var(--bg);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    font-weight: 700;
  }
  .admin-table td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  .admin-table tr:last-child td { border-bottom: none; }
  .admin-table tr:hover td { background: var(--bg); }

  /* ===== TABS ===== */
  .tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 20px;
    background: var(--border);
    padding: 4px;
    border-radius: var(--radius-sm);
    width: fit-content;
  }
  .tab {
    padding: 7px 16px;
    border-radius: 6px;
    border: none;
    background: none;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    color: var(--text-muted);
    transition: all 0.15s;
  }
  .tab.active { background: #fff; color: var(--text); box-shadow: var(--shadow); }

  /* ===== SEARCH ===== */
  .search-box {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  .search-input {
    flex: 1;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 9px 14px;
    font-size: 13px;
    font-family: inherit;
    outline: none;
  }
  .search-input:focus { border-color: var(--blue); }

  /* ===== STAT CARDS ===== */
  .stat-card {
    background: var(--card);
    border-radius: var(--radius);
    padding: 16px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .stat-num {
    font-size: 28px;
    font-weight: 900;
    color: var(--text);
    line-height: 1;
    margin-bottom: 4px;
  }
  .stat-label { font-size: 12px; color: var(--text-muted); font-weight: 600; }
  .stat-accent { color: var(--blue); }

  /* ===== MODAL (route detail) ===== */
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 200;
    display: flex; align-items: center; justify-content: center;
    padding: 20px;
  }
  .modal {
    background: #fff;
    border-radius: var(--radius);
    max-width: 700px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    box-shadow: var(--shadow-lg);
  }
  .modal-header {
    padding: 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    position: sticky; top: 0;
    background: #fff;
    z-index: 1;
  }
  .modal-body { padding: 20px; }
  .modal-close {
    margin-left: auto;
    background: var(--bg);
    border: none;
    width: 32px; height: 32px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 16px;
    display: flex; align-items: center; justify-content: center;
  }

  /* ===== FLEET LIST ===== */
  .fleet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 8px;
  }
  .fleet-card {
    background: var(--bg);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    border: 1px solid var(--border);
  }
  .fleet-num { font-size: 13px; font-weight: 800; color: var(--text); }
  .fleet-reg { font-size: 11px; color: var(--text-muted); font-family: monospace; }
  .fleet-route { font-size: 11px; color: var(--blue-dark); font-weight: 600; margin-top: 4px; }

  /* misc */
  .divider { height: 1px; background: var(--border); margin: 20px 0; }
  .text-center { text-align: center; }
  .mt-4 { margin-top: 4px; }
  .mt-8 { margin-top: 8px; }
  .mt-12 { margin-top: 12px; }
  .mt-16 { margin-top: 16px; }
  .flex { display: flex; }
  .gap-8 { gap: 8px; }
  .gap-12 { gap: 12px; }
  .items-center { align-items: center; }
  .justify-between { justify-content: space-between; }
  .flex-wrap { flex-wrap: wrap; }
  .text-muted { color: var(--text-muted); font-size: 12px; }
  .text-red { color: var(--red); }
  .text-green { color: var(--green); }
  .text-yellow { color: var(--yellow-dark); }
  .fw-700 { font-weight: 700; }
  .empty-state { text-align: center; padding: 40px 20px; color: var(--text-muted); }
  .empty-state .big { font-size: 40px; margin-bottom: 8px; }

  /* HOME hero */
  .hero {
    background: linear-gradient(135deg, var(--text) 0%, #16213E 60%, #1A1A2E 100%);
    border-radius: var(--radius);
    padding: 28px 24px;
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
  }
  .hero::after {
    content: 'SIBS';
    position: absolute;
    right: -10px; bottom: -20px;
    font-size: 100px;
    font-weight: 900;
    color: rgba(245,194,0,0.06);
    pointer-events: none;
  }
  .hero-strip {
    height: 4px;
    background: linear-gradient(90deg, var(--yellow) 0%, var(--blue) 100%);
    border-radius: 2px;
    margin-bottom: 20px;
  }
  .hero-title {
    color: #fff;
    font-size: 24px;
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 6px;
  }
  .hero-title span { color: var(--yellow); }
  .hero-sub { color: rgba(255,255,255,0.6); font-size: 13px; margin-bottom: 20px; }
  .hero-btns { display: flex; gap: 10px; flex-wrap: wrap; }
  .hero-btn {
    padding: 10px 18px;
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    border: none;
    transition: all 0.15s;
  }
  .hero-btn-primary { background: var(--yellow); color: var(--text); }
  .hero-btn-primary:hover { background: var(--yellow-dark); }
  .hero-btn-secondary { background: rgba(255,255,255,0.1); color: #fff; border: 1.5px solid rgba(255,255,255,0.2); }
  .hero-btn-secondary:hover { background: rgba(255,255,255,0.18); }

  /* admin warn */
  .admin-header {
    background: linear-gradient(135deg, #1A1A2E, #2d1a5e);
    border-radius: var(--radius);
    padding: 16px 20px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-left: 4px solid var(--yellow);
  }
  .admin-header-text { color: #fff; }
  .admin-header-text strong { color: var(--yellow); font-size: 15px; display: block; }
  .admin-header-text span { font-size: 12px; color: rgba(255,255,255,0.6); }

  /* inline edit */
  .inline-edit-input {
    border: 1.5px solid var(--blue);
    border-radius: 4px;
    padding: 4px 8px;
    font-family: inherit;
