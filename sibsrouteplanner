}

function getNextBusMins(route, now) {
  // Determine interval based on time of day
  const h = now.getHours(), m = now.getMinutes();
  const mins = h*60+m;
  let interval = 15; // default
  const peak = isPeakHour(now);
  if(peak) interval = 6;
  else if(mins < 7*60) interval = 15;
  else interval = 12;

  // Next bus based on interval from last departure
  const startMins = 5*60+30; // 05:30
  const elapsed = mins - startMins;
  if(elapsed < 0) return startMins - mins;
  const remainder = elapsed % interval;
  return remainder === 0 ? 0 : interval - remainder;
}

function updateArrivals() {
  const stop = document.getElementById('stopSelector').value;
  const routeFilter = document.getElementById('arrRouteFilter').value;
  if(!stop) return;

  const now = new Date();
  const wrap = document.getElementById('arrivalsBoardWrap');

  // Find routes serving this stop
  let servingRoutes = ROUTES.filter(r => r.stops.includes(stop));
  if(routeFilter) servingRoutes = servingRoutes.filter(r=>r.id===routeFilter);

  if(servingRoutes.length===0) {
    wrap.innerHTML = `<div class="empty-state"><div class="big">🚏</div><p>No routes serve this stop</p></div>`;
    return;
  }

  // Build arrivals
  const arrivals = [];
  servingRoutes.forEach(route => {
    const diversion = state.diversions.find(d=>d.route===route.id);
    const alloc = state.currentAllocation[route.id] || {};
    const peak = isPeakHour(now);

    // Both directions
    [route.from, route.to].forEach(dest => {
      if(dest === stop) return;
      const stopIdx = route.stops.indexOf(stop);
      const baseNextMins = getNextBusMins(route, now);
      const travelToStop = stopIdx * (parseInt(route.journey) / (route.stops.length-1));

      // Show next 3 departures
      for(let i=0;i<3;i++) {
        const minsAway = Math.round(baseNextMins + travelToStop + i*getNextBusMins(route,now)*2);
        const buses = alloc.regular || [];
        const bus = buses[i % (buses.length||1)];
        const arrTime = new Date(now.getTime() + minsAway*60000);
        const hh = String(arrTime.getHours()).padStart(2,'0');
        const mm = String(arrTime.getMinutes()).padStart(2,'0');

        // Delay simulation
        const divertedStop = diversion && diversion.stops && diversion.stops.includes(stop);
        const delayed = divertedStop || Math.random() < 0.1;
        const delayMins = delayed ? Math.floor(Math.random()*5)+1 : 0;

        arrivals.push({
          route, dest, minsAway, hh, mm, bus, delayed, delayMins, diversion
        });
      }
    });
  });

  arrivals.sort((a,b)=>a.minsAway-b.minsAway);

  wrap.innerHTML = `
    <div class="arrivals-board">
      <div class="arrivals-header">
        <span>🚏 ${stop}</span>
        <span style="font-weight:400;font-size:11px">Updated ${new Date().toLocaleTimeString()}</span>
      </div>
      <div class="arrivals-cols">
        <div class="arrivals-col-label">Route</div>
        <div class="arrivals-col-label">Destination</div>
        <div class="arrivals-col-label">Arrives</div>
        <div class="arrivals-col-label">Fleet</div>
        <div class="arrivals-col-label">Status</div>
      </div>
      ${arrivals.slice(0,12).map(a=>`
        <div class="arrivals-row">
          <span class="route-tag ${a.route.operator}">${a.route.id}</span>
          <span class="arr-dest">${a.dest}</span>
          <span class="arr-time">${a.minsAway===0?'NOW':a.minsAway+' min'}</span>
          <span class="arr-fleet">${a.bus ? '#'+a.bus+' '+((FLEET_MASTER[a.bus]||'').substring(0,6)) : '—'}</span>
          <span class="arr-status ${a.delayed?'delayed':'on-time'}">${a.delayed?`+${a.delayMins}min delay`:'On time'}</span>
        </div>`).join('')}
    </div>
  `;
}

