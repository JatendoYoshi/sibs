// TIMETABLE OVERRIDES
// ============================================================
function renderTimetableOverrides() {
  const wrap = document.getElementById('timetableOverrideList');
  wrap.innerHTML = ROUTES.map(route => {
    const ov = state.timetableOverrides[route.id] || {};
    return `
    <div class="card" style="margin-bottom:12px">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
        <span class="route-tag ${route.operator}">${route.id}</span>
        <span style="font-weight:700;flex:1">${route.name}</span>
        <span class="text-muted">Normal interval: ${route.interval}</span>
      </div>
      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
        <div class="form-group">
          <label class="form-label">Override Interval</label>
          <input class="form-input" style="width:160px" value="${ov.interval||''}" placeholder="e.g. 10–15 min"
            oninput="state.timetableOverrides['${route.id}'] = {...(state.timetableOverrides['${route.id}']||{}), interval:this.value}"/>
        </div>
        <div class="form-group">
          <label class="form-label">Note</label>
          <input class="form-input" style="width:220px" value="${ov.note||''}" placeholder="Reason for change…"
            oninput="state.timetableOverrides['${route.id}'] = {...(state.timetableOverrides['${route.id}']||{}), note:this.value}"/>
        </div>
        ${ov.interval ? `<span class="pill" style="background:#FEF3C7;color:#92400E;align-self:flex-end;margin-bottom:2px">Override active</span>` : ''}
      </div>
    </div>`;
  }).join('');
}

