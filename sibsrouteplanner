function swapStops() {
  const f = document.getElementById('planFrom');
  const t = document.getElementById('planTo');
  const tmp = f.value; f.value = t.value; t.value = tmp;
}

function planJourney() {
  const from = document.getElementById('planFrom').value;
  const to = document.getElementById('planTo').value;
  const results = document.getElementById('planResults');

  if(!from || !to) {
    results.innerHTML = `<div class="card"><p class="text-muted">Please select both an origin and a destination.</p></div>`;
    return;
  }
  if(from===to) {
    results.innerHTML = `<div class="card"><p class="text-muted">Origin and destination are the same stop.</p></div>`;
    return;
  }

  const options = [];

  // Find direct routes
  ROUTES.forEach(route => {
    const fi = route.stops.indexOf(from);
    const ti = route.stops.indexOf(to);
    if(fi >= 0 && ti >= 0 && fi !== ti) {
      const stops = Math.abs(ti - fi);
      const journeyMins = Math.round(stops * parseInt(route.journey) / (route.stops.length-1));
      const fare = parseFloat(route.fare.replace('$',''));
      options.push({
        type:'direct',
        routes:[route],
        stops: [from, to],
        totalMins: journeyMins,
        totalFare: fare,
        transfers: 0,
        label: `${route.id}: ${from} → ${to}`,
      });
    }
  });

  // Find 1-transfer options via interchange stops
  const interchanges = ['Northern Interchange','Sunshine Station','Zone 7 Interchange',
    'Western Harbour Tunnel Interchange','Central Hospital','Southern Central',
    'Long Island Ferry Pier','Norton Town Center'];

  interchanges.forEach(interchange => {
    ROUTES.forEach(r1 => {
      const fi = r1.stops.indexOf(from);
      const ii1 = r1.stops.indexOf(interchange);
      if(fi < 0 || ii1 < 0) return;
      ROUTES.forEach(r2 => {
        if(r1.id===r2.id) return;
        const ii2 = r2.stops.indexOf(interchange);
        const ti = r2.stops.indexOf(to);
        if(ii2 < 0 || ti < 0) return;
        const stops1 = Math.abs(ii1 - fi);
        const stops2 = Math.abs(ti - ii2);
        const mins1 = Math.round(stops1 * parseInt(r1.journey) / (r1.stops.length-1));
        const mins2 = Math.round(stops2 * parseInt(r2.journey) / (r2.stops.length-1));
        const fare1 = parseFloat(r1.fare.replace('$',''));
        const fare2 = parseFloat(r2.fare.replace('$',''));
        // BBI discount (10% at interchange)
        const totalFare = parseFloat((fare1 + fare2 * 0.9).toFixed(1));
        options.push({
          type:'transfer',
          routes:[r1,r2],
          stops:[from, interchange, to],
          totalMins: mins1 + 5 + mins2, // 5 min transfer
          totalFare,
          transfers:1,
          label:`${r1.id} → change at ${interchange} → ${r2.id}`,
          interchange,
        });
      });
    });
  });

  // Deduplicate and sort
  const seen = new Set();
  const unique = options.filter(o => {
    const key = o.label;
    if(seen.has(key)) return false;
    seen.add(key); return true;
  });

  if(unique.length===0) {
    results.innerHTML = `<div class="card"><div class="empty-state"><div class="big">🗺️</div><p>No routes found between these stops.<br>Try selecting stops on the same or connecting routes.</p></div></div>`;
    return;
  }

  const sorted = unique.sort((a,b)=>a.totalMins-b.totalMins);
  const fastest = sorted[0];
  const cheapest = [...unique].sort((a,b)=>a.totalFare-b.totalFare)[0];
  const directs = unique.filter(o=>o.type==='direct');

  results.innerHTML = `
    <div class="card">
      <div class="card-title"><div class="icon">📍</div> ${unique.length} option${unique.length!==1?'s':''} found: ${from} → ${to}</div>
      ${sorted.slice(0,6).map((opt,i)=>{
        const isFastest = opt===fastest;
        const isCheapest = opt===cheapest;
        const isDirect = opt.type==='direct';
        const badges = [];
        if(isFastest) badges.push('<span class="journey-badge fastest">Fastest</span>');
        if(isCheapest && opt!==fastest) badges.push('<span class="journey-badge cheapest">Cheapest</span>');
        if(isDirect) badges.push('<span class="journey-badge direct">Direct</span>');
        return `
        <div class="journey-option ${i===0?'best':''}">
          <div>${badges.join(' ')}</div>
          <div class="journey-steps">
            <strong>${opt.stops[0]}</strong>
            ${opt.routes.map((r,ri)=>`
              <span class="journey-arrow">→</span>
              <span class="route-tag ${r.operator}" style="font-size:11px;padding:2px 7px">${r.id}</span>
              ${opt.stops[ri+1]?`<span class="journey-arrow">→</span><strong>${opt.stops[ri+1]}</strong>`:''}
            `).join('')}
          </div>
          ${opt.transfers>0 ? `<div class="text-muted mt-4">🔄 Change at ${opt.interchange} (approx. 5 min wait)</div>` : ''}
          <div class="journey-footer">
            <span>⏱ <strong>${opt.totalMins} min</strong></span>
            <span>💵 <strong>$${opt.totalFare}</strong></span>
            <span>🚌 <strong>${opt.transfers===0?'Direct':'1 transfer'}</strong></span>
            ${opt.transfers>0?'<span class="text-muted">BBI interchange discount applied</span>':''}
          </div>
        </div>`;
      }).join('')}
    </div>`;
}

